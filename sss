<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BOXERR — Gaming Community</title>

<style>
:root {
  --bg: #090b12;
  --panel: #141827;
  --panel2: #1b2133;
  --border: #2b3248;
  --text: #f5f6ff;
  --muted: #a2aac0;
  --purple: #9d5cff;
  --cyan: #39f5d0;
  --pink: #ff4f9a;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background:
    radial-gradient(ellipse at 0 0, #512a7533, transparent 40%),
    radial-gradient(ellipse at 100% 30%, #075c5220, transparent 35%),
    var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

button, input, textarea, select {
  font: inherit;
}

button {
  cursor: pointer;
  color: var(--text);
  background: var(--panel2);
  border: 1px solid var(--border);
  padding: 11px 15px;
  border-radius: 11px;
  transition: 0.2s;
}

button:hover {
  border-color: var(--cyan);
  transform: translateY(-1px);
}

.primary {
  background: linear-gradient(120deg, #9d5cff, #7149f5);
  border: 0;
  font-weight: bold;
}

input, textarea, select {
  width: 100%;
  background: #0c101a;
  color: white;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px;
}

textarea {
  min-height: 130px;
  resize: vertical;
}

.hidden {
  display: none !important;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 15px 5%;
  background: #090b12ed;
  backdrop-filter: blur(15px);
  border-bottom: 1px solid var(--border);
}

.logo {
  font-size: 23px;
  font-weight: 1000;
  letter-spacing: -1px;
}

.logo span {
  color: var(--cyan);
}

.header-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

#usernameLabel {
  color: var(--cyan);
  font-size: 13px;
}

.layout {
  width: min(1350px, 94%);
  margin: 25px auto;
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 22px;
}

.sidebar {
  align-self: start;
  position: sticky;
  top: 88px;
  background: #111522ed;
  border: 1px solid var(--border);
  border-radius: 17px;
  padding: 12px;
}

.nav-button {
  display: block;
  width: 100%;
  text-align: left;
  margin: 4px 0;
  padding: 14px;
  color: var(--muted);
  background: transparent;
  border-color: transparent;
}

.nav-button.active {
  background: #9d5cff20;
  border-color: #9d5cff80;
  color: white;
}

.side-info {
  margin-top: 20px;
  padding: 12px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

main {
  min-width: 0;
}

.page {
  display: block;
}

.hero {
  padding: 30px;
  margin-bottom: 23px;
  border: 1px solid #49366e;
  border-radius: 22px;
  background:
    radial-gradient(circle at 90% 20%, #9d5cff35, transparent 38%),
    linear-gradient(130deg, #19162c, #111824);
}

.eyebrow {
  color: var(--cyan);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
}

.hero h1 {
  font-size: clamp(32px, 5vw, 52px);
  line-height: 1.1;
  letter-spacing: -2px;
  margin: 12px 0;
}

.hero h1 span {
  color: var(--purple);
}

.hero p {
  max-width: 600px;
  color: var(--muted);
  line-height: 1.8;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 25px 0 15px;
}

.section-title h2 {
  margin: 0;
}

.muted {
  color: var(--muted);
}

.toolbar {
  display: flex;
  gap: 10px;
}

.toolbar input {
  flex: 1;
  min-width: 0;
}

.feed {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.card {
  min-width: 0;
  overflow: hidden;
  background: linear-gradient(145deg, #171c2b, #10131c);
  border: 1px solid var(--border);
  border-radius: 17px;
}

.card-media {
  width: 100%;
  max-height: 380px;
  object-fit: cover;
  display: block;
  background: #050608;
}

.card-body {
  padding: 16px;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.tag {
  display: inline-block;
  border: 1px solid #39f5d04c;
  background: #39f5d010;
  color: var(--cyan);
  padding: 5px 9px;
  border-radius: 30px;
  font-size: 11px;
  font-weight: bold;
}

.card h3 {
  margin: 13px 0;
  overflow-wrap: anywhere;
}

.description {
  color: #c0c6d7;
  line-height: 1.7;
  font-size: 14px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

.card-footer small {
  color: var(--muted);
}

.like-btn.liked {
  color: var(--pink);
  border-color: var(--pink);
}

.delete-btn {
  color: #ff7585;
}

.form-card {
  max-width: 750px;
  margin: auto;
  padding: 25px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.form-card h2 {
  margin-top: 0;
}

.field {
  margin: 18px 0;
}

.field label {
  display: block;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 8px;
}

.upload-zone {
  display: block;
  border: 2px dashed #414963;
  border-radius: 15px;
  padding: 28px 15px;
  text-align: center;
  color: var(--muted);
  cursor: pointer;
  line-height: 1.8;
}

.upload-zone.dragging {
  border-color: var(--cyan);
  background: #39f5d010;
}

.upload-zone input {
  display: none;
}

.preview {
  display: block;
  max-width: 100%;
  max-height: 320px;
  margin: 15px auto;
  border-radius: 12px;
}

.auth-wrap {
  max-width: 440px;
  margin: 40px auto;
}

.auth-card {
  padding: 25px;
  border: 1px solid var(--border);
  background: var(--panel);
  border-radius: 20px;
}

.auth-card h1 {
  margin-bottom: 10px;
}

.auth-card p {
  color: var(--muted);
  line-height: 1.6;
}

.auth-tabs {
  display: flex;
  gap: 8px;
  margin: 20px 0;
}

.auth-tabs button {
  flex: 1;
}

.auth-tabs button.active {
  border-color: var(--purple);
  background: #9d5cff25;
}

.message {
  padding: 12px;
  margin: 12px 0;
  border-radius: 10px;
  font-size: 13px;
}

.message.error {
  color: #ff9eac;
  background: #ff4f9a16;
}

.message.success {
  color: var(--cyan);
  background: #39f5d015;
}

.reels-feed {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}

.reel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
  overflow: hidden;
}

.reel video {
  width: 100%;
  height: 360px;
  object-fit: cover;
  background: black;
}

.reel-info {
  padding: 13px;
}

.reel-info h3 {
  overflow-wrap: anywhere;
}

.reel-info p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 45px 15px;
  border: 1px dashed #363d52;
  border-radius: 15px;
  color: var(--muted);
}

footer {
  text-align: center;
  padding: 30px;
  font-size: 12px;
  color: var(--muted);
}

@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
    display: flex;
    overflow-x: auto;
    gap: 4px;
  }

  .nav-button {
    width: auto;
    white-space: nowrap;
  }

  .side-info {
    display: none;
  }

  .reels-feed {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .topbar {
    padding: 12px 3%;
  }

  .logo {
    font-size: 18px;
  }

  .header-actions button {
    padding: 8px;
    font-size: 12px;
  }

  #usernameLabel {
    display: none;
  }

  .layout {
    width: 94%;
    margin-top: 15px;
  }

  .hero {
    padding: 22px;
  }

  .feed,
  .reels-feed {
    grid-template-columns: 1fr;
  }

  .toolbar {
    flex-wrap: wrap;
  }

  .toolbar input {
    flex-basis: 100%;
  }

  .form-card,
  .auth-card {
    padding: 17px;
  }
}
</style>
</head>

<body>

<header class="topbar">
  <div class="logo">GAME<span>VERSE</span> 🎮</div>

  <div class="header-actions">
    <span id="usernameLabel"></span>
    <button id="signInButton" onclick="showPage('auth')">Sign In</button>
    <button id="createButton" class="primary" onclick="showPage('create')">+ Create</button>
    <button id="logoutButton" class="hidden" onclick="logout()">Log out</button>
  </div>
</header>

<div class="layout">

  <aside class="sidebar">
    <button class="nav-button active" data-page="home" onclick="showPage('home')">⌂ &nbsp; Home</button>
    <button class="nav-button" data-page="stories" onclick="showPage('stories')">📝 &nbsp; Stories</button>
    <button class="nav-button" data-page="reels" onclick="showPage('reels')">▶ &nbsp; Reels</button>
    <button class="nav-button" data-page="create" onclick="showPage('create')">＋ &nbsp; Create Post</button>
    <button class="nav-button" data-page="about" onclick="showPage('about')">ⓘ &nbsp; About</button>

    <div class="side-info">
      YOUR GAME. YOUR STORY.<br>
      Share your wins, fails, screenshots, and unforgettable gaming moments.
    </div>
  </aside>

  <main>

    <!-- HOME -->
    <section id="page-home" class="page">
      <div class="hero">
        <div class="eyebrow">THE GAMING COMMUNITY</div>
        <h1>Your games.<br>Your <span>legend.</span></h1>
        <p>
          Share epic wins, funny fails, gaming screenshots, and your
          unforgettable adventures with the community.
        </p>
        <button class="primary" onclick="showPage('create')">
          Share your experience →
        </button>
      </div>

      <div class="toolbar">
        <input id="searchInput" placeholder="🔎 Search games and stories...">
        <button onclick="renderAll()">Search</button>
      </div>

      <div class="section-title">
        <h2>Latest gaming stories</h2>
        <span id="postCount" class="muted"></span>
      </div>

      <div id="homeFeed" class="feed"></div>
    </section>

    <!-- STORIES -->
    <section id="page-stories" class="page hidden">
      <div class="section-title">
        <h2> Gaming Stories</h2>
        <span class="muted">Experiences from gamers</span>
      </div>

      <div id="storiesFeed" class="feed"></div>
    </section>

    <!-- REELS -->
    <section id="page-reels" class="page hidden">
      <div class="hero">
        <div class="eyebrow">GAMING CLIPS</div>
        <h1>Gaming <span>Reels</span> ▶</h1>
        <p>Watch gaming videos shared by the community.</p>
      </div>

      <div id="reelsFeed" class="reels-feed"></div>
    </section>

    <!-- CREATE POST -->
    <section id="page-create" class="page hidden">
      <form id="postForm" class="form-card">
        <h2>🚀 Share your experience</h2>
        <p class="muted">Tell the community about your latest adventure.</p>

        <div id="postMessage"></div>

        <div class="field">
          <label for="gameName">Game name *</label>
          <input id="gameName" required maxlength="80" placeholder="Minecraft, GTA V, BGMI...">
        </div>

        <div class="field">
          <label for="postTitle">Post title *</label>
          <input id="postTitle" required maxlength="120" placeholder="Give your story a title">
        </div>

        <div class="field">
          <label for="postDescription">Your gaming experience *</label>
          <textarea id="postDescription" required maxlength="5000" placeholder="What happened in your game?"></textarea>
        </div>

        <div class="field">
          <label>Image or video (optional)</label>

          <label id="uploadZone" class="upload-zone" for="mediaInput">
            <strong>📁 Drag and drop your image or video</strong><br>
            Or click here to choose a file<br>
            <small>Maximum size: 20 MB per file</small>
            <input id="mediaInput" type="file" accept="image/*,video/mp4,video/webm,video/quicktime">
          </label>

          <div id="mediaPreview"></div>
          <button id="removeMediaButton" type="button" class="hidden" onclick="clearMedia()">Remove media</button>
        </div>

        <button id="publishButton" type="submit" class="primary" style="width:100%">
          Publish gaming post 🚀
        </button>
      </form>
    </section>

    <!-- ABOUT -->
    <section id="page-about" class="page hidden">
      <div class="form-card">
        <div class="eyebrow">ABOUT THE COMMUNITY</div>
        <h2>Welcome to GAMEVERSE</h2>

        <p class="description">
          GAMEVERSE is a place for gamers to share experiences, gaming
          stories, screenshots, and videos. It is a community website,
          not a website for playing games.
        </p>

        <h3>Community rules</h3>

        <p class="description">
          • Respect other gamers.<br>
          • Share content you have permission to publish.<br>
          • Do not share private information.<br>
          • Keep the community welcoming.
        </p>
      </div>
    </section>

    <!-- SIGN IN / REGISTER -->
    <section id="page-auth" class="page hidden">
      <div class="auth-wrap">
        <div class="auth-card">
          <div class="eyebrow">WELCOME, GAMER</div>
          <h1 id="authHeading">Welcome back!</h1>
          <p id="authDescription">Sign in to share your gaming experiences.</p>

          <div class="auth-tabs">
            <button id="loginTab" class="active" onclick="setAuthMode('login')">Sign In</button>
            <button id="registerTab" onclick="setAuthMode('register')">Create Account</button>
          </div>

          <div id="authMessage"></div>

          <form id="authForm">
            <div class="field">
              <label for="authUsername">Username</label>
              <input id="authUsername" required minlength="3" maxlength="20" autocomplete="username" placeholder="YourGamerName">
            </div>

            <div class="field">
              <label for="authPassword">Password</label>
              <input id="authPassword" type="password" required minlength="8" maxlength="72" autocomplete="current-password" placeholder="At least 8 characters">
            </div>

            <button id="authSubmit" class="primary" style="width:100%" type="submit">
              Sign In
            </button>
          </form>

          <p style="font-size:12px">
            This single-file version stores demo accounts in your browser.
            Do not use a real or reused password.
          </p>
        </div>
      </div>
    </section>

  </main>
</div>

<footer>GAMEVERSE © 2026 · Built for gamers, by gamers 🎮</footer>

<script>
"use strict";

/* ---------------------------------------
   GAMEVERSE: LOCAL BROWSER VERSION
--------------------------------------- */

const $ = id => document.getElementById(id);

let currentUser = null;
let authMode = "login";
let selectedMedia = null;
let mediaObjectURL = null;
let posts = [];
let users = {};

function loadStorage() {
  try {
    posts = JSON.parse(localStorage.getItem("gv_posts") || "[]");
    users = JSON.parse(localStorage.getItem("gv_users") || "{}");
  } catch {
    posts = [];
    users = {};
  }

  try {
    const savedUser = sessionStorage.getItem("gv_current_user");
    currentUser = savedUser ? JSON.parse(savedUser) : null;
  } catch {
    currentUser = null;
  }

  updateHeader();
  renderAll();
}

function savePosts() {
  localStorage.setItem("gv_posts", JSON.stringify(posts));
}

function saveUsers() {
  localStorage.setItem("gv_users", JSON.stringify(users));
}

function escapeHTML(value = "") {
  return String(value).replace(/[&<>"']/g, character => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[character]);
}

/* FIXED NAVIGATION FUNCTION */

function showPage(page) {
  const allowedPages = ["home", "stories", "reels", "create", "about", "auth"];

  if (!allowedPages.includes(page)) {
    console.error("Unknown page:", page);
    return;
  }

  if (page === "create" && !currentUser) {
    page = "auth";
    setAuthMode("login");
    showAuthMessage("Sign in or create an account before publishing.");
  }

  // Hide every page.
  document.querySelectorAll(".page").forEach(section => {
    section.classList.add("hidden");
  });

  // Show the selected page.
  const selectedPage = $("page-" + page);

  if (!selectedPage) {
    console.error("Page not found:", page);
    return;
  }

  selectedPage.classList.remove("hidden");

  // Update sidebar navigation.
  document.querySelectorAll(".nav-button").forEach(button => {
    button.classList.toggle(
      "active",
      button.dataset.page === page
    );
  });

  // Load the correct content.
  if (page === "home" || page === "stories" || page === "reels") {
    renderAll();
  }

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

function updateHeader() {
  $("usernameLabel").textContent = currentUser
    ? "👤 " + currentUser.username
    : "";

  $("signInButton").classList.toggle("hidden", Boolean(currentUser));
  $("createButton").classList.toggle("hidden", !currentUser);
  $("logoutButton").classList.toggle("hidden", !currentUser);
}

function setAuthMode(mode) {
  authMode = mode;

  $("loginTab").classList.toggle("active", mode === "login");
  $("registerTab").classList.toggle("active", mode === "register");

  $("authHeading").textContent = mode === "login"
    ? "Welcome back!"
    : "Join GAMEVERSE";

  $("authDescription").textContent = mode === "login"
    ? "Sign in to share your gaming experiences."
    : "Create your gamer account.";

  $("authSubmit").textContent = mode === "login"
    ? "Sign In"
    : "Create Account";

  $("authPassword").autocomplete = mode === "login"
    ? "current-password"
    : "new-password";

  $("authMessage").innerHTML = "";
}

function showAuthMessage(message, success = false) {
  $("authMessage").innerHTML =
    `<div class="message ${success ? "success" : "error"}">${escapeHTML(message)}</div>`;
}

/* SIGN IN AND REGISTER */

$("authForm").addEventListener("submit", event => {
  event.preventDefault();

  const username = $("authUsername").value.trim();
  const password = $("authPassword").value;

  if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
    showAuthMessage("Use 3–20 letters, numbers, or underscores for your username.");
    return;
  }

  if (password.length < 8) {
    showAuthMessage("Your password must contain at least 8 characters.");
    return;
  }

  const usernameKey = username.toLowerCase();

  if (authMode === "register") {
    if (users[usernameKey]) {
      showAuthMessage("That username is already registered.");
      return;
    }

    /*
      Demo-only account storage.
      This is NOT secure authentication.
      Do not use real passwords here.
    */
    users[usernameKey] = {
      username,
      password
    };

    saveUsers();

    currentUser = { username };

    sessionStorage.setItem(
      "gv_current_user",
      JSON.stringify(currentUser)
    );

    updateHeader();

    $("authForm").reset();

    showAuthMessage("Account created successfully!", true);

    setTimeout(() => showPage("home"), 500);
    return;
  }

  const storedUser = users[usernameKey];

  if (!storedUser || storedUser.password !== password) {
    showAuthMessage("Incorrect username or password.");
    return;
  }

  currentUser = {
    username: storedUser.username
  };

  sessionStorage.setItem(
    "gv_current_user",
    JSON.stringify(currentUser)
  );

  updateHeader();

  $("authForm").reset();

  showAuthMessage("Signed in successfully!", true);

  setTimeout(() => showPage("home"), 500);
});

function logout() {
  currentUser = null;
  sessionStorage.removeItem("gv_current_user");
  updateHeader();
  showPage("home");
}

/* POSTS */

function postCard(post) {
  const media = post.mediaData
    ? post.mediaType === "video"
      ? `<video class="card-media" src="${post.mediaData}" controls preload="metadata"></video>`
      : `<img class="card-media" src="${post.mediaData}" alt="Gaming screenshot" loading="lazy">`
    : "";

  const deleteButton = currentUser &&
    currentUser.username === post.username
    ? `<button class="delete-btn" onclick="deletePost('${post.id}')">Delete</button>`
    : "";

  const liked = currentUser &&
    Array.isArray(post.likedBy) &&
    post.likedBy.includes(currentUser.username);

  return `
    <article class="card">
      ${media}

      <div class="card-body">
        <div class="card-top">
          <span class="tag">${escapeHTML(post.game)}</span>
          <small class="muted">@${escapeHTML(post.username)}</small>
        </div>

        <h3>${escapeHTML(post.title)}</h3>

        <div class="description">${escapeHTML(post.description)}</div>

        <div class="card-footer">
          <small>${escapeHTML(post.date)}</small>

          <div style="display:flex;gap:6px">
            <button
              class="like-btn ${liked ? "liked" : ""}"
              onclick="toggleLike('${post.id}')">
              ♥ ${(post.likedBy || []).length}
            </button>

            ${deleteButton}
          </div>
        </div>
      </div>
    </article>
  `;
}

function reelCard(post) {
  return `
    <article class="reel">
      <video src="${post.mediaData}" controls playsinline preload="metadata"></video>

      <div class="reel-info">
        <span class="tag">${escapeHTML(post.game)}</span>
        <h3>${escapeHTML(post.title)}</h3>
        <p>@${escapeHTML(post.username)}</p>
        <p>${escapeHTML(post.description)}</p>
        ${postCardLikeButton(post)}
      </div>
    </article>
  `;
}

function postCardLikeButton(post) {
  const liked = currentUser &&
    (post.likedBy || []).includes(currentUser.username);

  return `
    <button class="like-btn ${liked ? "liked" : ""}"
      onclick="toggleLike('${post.id}')">
      ♥ ${(post.likedBy || []).length}
    </button>
  `;
}

function emptyMessage() {
  return `
    <div class="empty">
      <div style="font-size:42px">🎮</div>
      <h3>No posts found</h3>
      <p>Be the first gamer to share an experience!</p>
    </div>
  `;
}

function renderFeed(element, list, renderer) {
  if (!list.length) {
    element.innerHTML = emptyMessage();
    return;
  }

  element.innerHTML = list.map(renderer).join("");
}

function renderAll() {
  const search = $("searchInput").value.trim().toLowerCase();

  const filtered = posts.filter(post => {
    const text = [
      post.game,
      post.title,
      post.description,
      post.username
    ].join(" ").toLowerCase();

    return text.includes(search);
  });

  $("postCount").textContent = filtered.length + " posts";

  renderFeed($("homeFeed"), filtered, postCard);
  renderFeed($("storiesFeed"), filtered, postCard);

  const videos = filtered.filter(post => post.mediaType === "video");

  renderFeed($("reelsFeed"), videos, reelCard);
}

$("searchInput").addEventListener("input", renderAll);

function toggleLike(id) {
  if (!currentUser) {
    setAuthMode("login");
    showPage("auth");
    showAuthMessage("Sign in to like posts.");
    return;
  }

  const post = posts.find(item => item.id === id);

  if (!post) return;

  post.likedBy = post.likedBy || [];

  const index = post.likedBy.indexOf(currentUser.username);

  if (index >= 0) {
    post.likedBy.splice(index, 1);
  } else {
    post.likedBy.push(currentUser.username);
  }

  savePosts();
  renderAll();
}

function deletePost(id) {
  const post = posts.find(item => item.id === id);

  if (!post || !currentUser ||
      post.username !== currentUser.username) {
    alert("You can delete only your own posts.");
    return;
  }

  if (!confirm("Delete this gaming post?")) return;

  posts = posts.filter(item => item.id !== id);
  savePosts();
  renderAll();
}

/* IMAGE AND VIDEO UPLOAD */

const mediaInput = $("mediaInput");
const uploadZone = $("uploadZone");

function clearMedia() {
  if (mediaObjectURL) {
    URL.revokeObjectURL(mediaObjectURL);
    mediaObjectURL = null;
  }

  selectedMedia = null;
  mediaInput.value = "";

  $("mediaPreview").innerHTML = "";
  $("removeMediaButton").classList.add("hidden");
}

function setSelectedMedia(file) {
  if (!file) return;

  if (!file.type.startsWith("image/") &&
      !file.type.startsWith("video/")) {
    alert("Please select an image or video.");
    return;
  }

  if (file.size > 20 * 1024 * 1024) {
    alert("Choose a file smaller than 20 MB.");
    return;
  }

  selectedMedia = file;

  if (mediaObjectURL) {
    URL.revokeObjectURL(mediaObjectURL);
  }

  mediaObjectURL = URL.createObjectURL(file);

  if (file.type.startsWith("video/")) {
    $("mediaPreview").innerHTML =
      `<video class="preview" src="${mediaObjectURL}" controls></video>`;
  } else {
    $("mediaPreview").innerHTML =
      `<img class="preview" src="${mediaObjectURL}" alt="Upload preview">`;
  }

  $("removeMediaButton").classList.remove("hidden");
}

mediaInput.addEventListener("change", () => {
  setSelectedMedia(mediaInput.files[0]);
});

uploadZone.addEventListener("dragover", event => {
  event.preventDefault();
  uploadZone.classList.add("dragging");
});

uploadZone.addEventListener("dragleave", () => {
  uploadZone.classList.remove("dragging");
});

uploadZone.addEventListener("drop", event => {
  event.preventDefault();
  uploadZone.classList.remove("dragging");

  const file = event.dataTransfer.files[0];

  if (file) setSelectedMedia(file);
});

/* CREATE POST */

$("postForm").addEventListener("submit", event => {
  event.preventDefault();

  if (!currentUser) {
    showPage("auth");
    showAuthMessage("Sign in before publishing a post.");
    return;
  }

  const game = $("gameName").value.trim();
  const title = $("postTitle").value.trim();
  const description = $("postDescription").value.trim();

  if (!game || !title || !description) {
    $("postMessage").innerHTML =
      '<div class="message error">Please complete all required fields.</div>';
    return;
  }

  const post = {
    id: crypto.randomUUID(),
    username: currentUser.username,
    game,
    title,
    description,
    date: new Date().toLocaleString(),
    mediaData: null,
    mediaType: null,
    likedBy: []
  };

  const button = $("publishButton");
  button.disabled = true;
  button.textContent = "Publishing...";

  const finishPost = () => {
    try {
      posts.unshift(post);
      savePosts();

      $("postForm").reset();
      clearMedia();

      $("postMessage").innerHTML =
        '<div class="message success">Your gaming post has been published!</div>';

      renderAll();

      setTimeout(() => showPage("home"), 800);
    } catch (error) {
      posts = posts.filter(item => item.id !== post.id);

      $("postMessage").innerHTML =
        '<div class="message error">Browser storage is full. Try a smaller image or video.</div>';
    } finally {
      button.disabled = false;
      button.textContent = "Publish gaming post 🚀";
    }
  };

  if (!selectedMedia) {
    finishPost();
    return;
  }

  const reader = new FileReader();

  reader.onload = () => {
    post.mediaData = reader.result;
    post.mediaType = selectedMedia.type.startsWith("video/")
      ? "video"
      : "image";

    finishPost();
  };

  reader.onerror = () => {
    button.disabled = false;
    button.textContent = "Publish gaming post 🚀";
    alert("Could not read that file.");
  };

  reader.readAsDataURL(selectedMedia);
});

/* START WEBSITE */

loadStorage();
</script>

